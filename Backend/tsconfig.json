{
  "compilerOptions": {
    "target": "ESNext",
   "module": "CommonJS",
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "outDir": "./dist",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ESNext", "DOM"],
    "types": ["node", "express", "./types/custom"],
  },
  "include": [
    "src/**/*.ts"
  ],
  "ts-node": {
    "esm": true
  }
}
